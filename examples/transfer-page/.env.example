# Скопируйте в .env.local и подставьте свои значения.
#
# projectId и publishableKey выдаёт control plane. Локально их печатает
# `make bootstrap` в haia-cp (см. README этого примера), в дев-окружении —
# дашборд, вкладка Project settings → API keys.

# UUID проекта. Уезжает в путь /v1/projects/{projectId}/policy/evaluate.
VITE_HAIA_PROJECT_ID=

# Публикуемый ключ (`pit_…`), scope-набор {ingest:write, policy:evaluate}.
# Секрета не несёт — он по построению живёт в бандле фронтенда.
VITE_HAIA_PUBLISHABLE_KEY=

# Хост control plane. Пусто → прод (https://api.haia.finance).
# Локальный ingest-сервис haia-cp: http://localhost:8000
VITE_HAIA_BASE_URL=http://localhost:8000

# Бюджет латентности на /evaluate, мс. Пусто → 400 (дефолт SDK).
# Полезно поднять, если control plane запущен на холодную и первый запрос
# упирается в бюджет — иначе fail-mode для перевода закроет отправку.
VITE_HAIA_LATENCY_BUDGET_MS=
