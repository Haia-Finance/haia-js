# Copy to .env.local and fill in your own values.
#
# projectId and publishableKey are issued by the control plane — in the
# dashboard, under Project settings → API keys.

# Project UUID. Goes into the path /v1/projects/{projectId}/policy/evaluate.
VITE_HAIA_PROJECT_ID=

# Publishable key (`pit_…`), scopes {ingest:write, policy:evaluate}.
# Carries no secret — by construction it lives in the frontend bundle.
VITE_HAIA_PUBLISHABLE_KEY=

# Control plane host. Empty → production (https://api.haia.finance).
# Set it to your own deployment to run against that instead.
VITE_HAIA_BASE_URL=

# Latency budget for /evaluate, in ms. Empty → 400 (the SDK default).
# Worth raising when the control plane is cold and the first request runs into
# the budget — otherwise fail-mode for a transfer blocks the send.
VITE_HAIA_LATENCY_BUDGET_MS=
